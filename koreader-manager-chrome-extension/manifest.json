{
  "manifest_version": 3,
  "name": "KOReader Manager",
  "version": "1.1",
  "description": "Export bookmarks to CSV and find KOReader device on network",
  "permissions": [
    "bookmarks",
    "downloads",
    "tabs",
    "activeTab",
    "notifications",
    "storage"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "key": ""
}
